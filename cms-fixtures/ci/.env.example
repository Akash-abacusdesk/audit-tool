# S6-D2 CI compose env (copy to .env beside docker-compose.ci.yml).
POSTGRES_USER=platform
POSTGRES_PASSWORD=devsecops
POSTGRES_DB=platform
PG_HOST_PORT=5433

MYSQL_ROOT_PASSWORD=devsecops
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=devsecops

# API sink (runs migrations incl 006_scan_findings).
API_DATABASE_URL=postgres://platform:devsecops@postgres:5432/platform?sslmode=disable

# Node CMS fixtures (Payload/Directus/Strapi/Next) DB wiring.
CMS_PAYLOAD_DATABASE_URL=postgres://platform:devsecops@postgres:5432/platform?sslmode=disable
CMS_NEXTPAYLOAD_DATABASE_URL=postgres://platform:devsecops@postgres:5432/platform?sslmode=disable

# CI egress allowlist toggle (see ci-egress-allowlist.sh).
WPVULNDB_ENABLED=0
CI_BRIDGE_CIDR=172.18.0.0/16
