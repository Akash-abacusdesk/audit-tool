# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=platform

# Host port bindings
PG_HOST_PORT=5433        # direct PG (migrations/admin only)
BOUNCER_HOST_PORT=6432   # PgBouncer — apps connect here

# Capacity knobs — tune per host; defaults are dev-sized, NOT production sizing.
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=256MB
BOUNCER_MAX_CLIENT_CONN=2000
BOUNCER_DEFAULT_POOL_SIZE=200
BOUNCER_MIN_POOL_SIZE=20
BOUNCER_RESERVE_POOL_SIZE=20
BOUNCER_RESERVE_POOL_TIMEOUT=5

# S2-D2 privileged admin (docs/security/privileged-admin-auth.md)
# Management networks allowed to reach admin routes (comma CIDRs).
# Prod: loopback + WireGuard mgmt net, e.g. 127.0.0.0/8,::1,10.10.0.0/24
ADMIN_NETS=127.0.0.0/8,::1,::ffff:127.0.0.0/104
ADMIN_STEPUP_TTL_MIN=15          # step-up proof max age
ADMIN_STEPUP_MAX_ATTEMPTS=5      # per window, per user
ADMIN_STEPUP_WINDOW_MIN=15
# Audit export spool (API blocks new privileged step-ups while .SPOOL_FULL exists)
AUDIT_SPOOL_DIR=./audit-spool
# Exporter-only vars (set in the exporter's environment, NOT the API):
AUDIT_EXPORT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= # dev-only 32-byte key; replace in real envs
# AUDIT_EXPORT_BATCH=500
# AUDIT_EXPORT_MAX_MB=100

# S3-D2 webhook ingress (docs/security/webhook-ingress-replay.md)
# Registered provider slugs — day-one ruling: github only.
GIT_PROVIDERS=github
# HMAC secret per provider, server-side ONLY (never repo/compose):
GIT_WEBHOOK_SECRET_GITHUB=change-me-openssl-rand-hex-32
WEBHOOK_MAX_AGE_MIN=10            # staleness window on the HTTP Date header
WEBHOOK_RATE_MAX=30               # accepted requests per IP+provider per window
WEBHOOK_RATE_WINDOW_MIN=1
WEBHOOK_BODY_LIMIT_BYTES=10485760 # max raw payload (GitHub hooks cap at 25MB)
WEBHOOK_RETENTION_DAYS=30         # daily pg-boss job prunes api_webhook_events
