# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=platform

# Host port bindings
PG_HOST_PORT=5433        # direct PG (migrations/admin only)
BOUNCER_HOST_PORT=6432   # PgBouncer — apps connect here

# Capacity knobs — tune per host; defaults are dev-sized, NOT production sizing.
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=256MB
BOUNCER_MAX_CLIENT_CONN=2000
BOUNCER_DEFAULT_POOL_SIZE=200
BOUNCER_MIN_POOL_SIZE=20
BOUNCER_RESERVE_POOL_SIZE=20
BOUNCER_RESERVE_POOL_TIMEOUT=5

# S2-D2 privileged admin (docs/security/privileged-admin-auth.md)
# Management networks allowed to reach admin routes (comma CIDRs).
# Prod: loopback + WireGuard mgmt net, e.g. 127.0.0.0/8,::1,10.10.0.0/24
ADMIN_NETS=127.0.0.0/8,::1,::ffff:127.0.0.0/104
ADMIN_STEPUP_TTL_MIN=15          # step-up proof max age
ADMIN_STEPUP_MAX_ATTEMPTS=5      # per window, per user
ADMIN_STEPUP_WINDOW_MIN=15
# Audit export spool (API blocks new privileged step-ups while .SPOOL_FULL exists)
AUDIT_SPOOL_DIR=./audit-spool
# Exporter-only vars (set in the exporter's environment, NOT the API):
AUDIT_EXPORT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= # dev-only 32-byte key; replace in real envs
# AUDIT_EXPORT_BATCH=500
# AUDIT_EXPORT_MAX_MB=100

# S3-D2 webhook ingress (docs/security/webhook-ingress-replay.md)
# Registered provider slugs — day-one ruling: github only.
GIT_PROVIDERS=github
# HMAC secret per provider, server-side ONLY (never repo/compose):
GIT_WEBHOOK_SECRET_GITHUB=change-me-openssl-rand-hex-32
WEBHOOK_MAX_AGE_MIN=10            # staleness window on the HTTP Date header
WEBHOOK_RATE_MAX=30               # accepted requests per IP+provider per window
WEBHOOK_RATE_WINDOW_MIN=1
WEBHOOK_BODY_LIMIT_BYTES=10485760 # max raw payload (GitHub hooks cap at 25MB)
WEBHOOK_RETENTION_DAYS=30         # daily pg-boss job prunes api_webhook_events

# S8-D1 WordPress mutation-event ingest (docs/cms/README.md)
# Dev-only fallback HMAC key; production sites each get their own row in
# wp_event_signing_keys (migration 007) provisioned per-site, not this var.
S8_WP_EVENT_SECRET=change-me-openssl-rand-hex-32

# S9-D1 Telegram operations (PRD §14). Inbound: verifies the
# X-Telegram-Bot-Api-Secret-Token header on POST /api/v1/telegram/callback.
# Outbound: TelegramClient (packages/shared/src/telegram-client.ts) sends
# alerts/approvals/reminders. Leave unset in dev — both paths degrade safely
# (inbound refuses callbacks; outbound calls are simply unavailable).
TELEGRAM_BOT_SECRET=change-me-openssl-rand-hex-32
TELEGRAM_BOT_TOKEN=

# S15 external Vaultwarden microservice private API (PRD §3, §4.2). Leave
# unset in dev/test — VaultwardenClientStore then reports UNAVAILABLE (503)
# instead of failing at boot.
VAULTWARDEN_BASE_URL=
VAULTWARDEN_API_TOKEN=

# S20 developer-triggered AI remediation (PRD §8.4-8.5). Leave unset in dev/
# test/CI — the ai_remediation workload class is also disabled by default
# (SCHED_AI_REMEDIATION_DISABLED=0 to enable) so this is a double safety gate.
ANTHROPIC_API_KEY=
AI_REMEDIATION_MODEL=
# Comma-separated allow-list; defaults to just AI_REMEDIATION_MODEL if unset.
AI_REMEDIATION_ALLOWED_MODELS=
SCHED_AI_REMEDIATION_DISABLED=1

# ---- Hardening knobs (all optional) ----
# BOOTSTRAP_TOKEN=            # if set, POST /auth/bootstrap needs header x-bootstrap-token
# TRUST_PROXY=10.0.0.5        # comma-separated proxy addresses/CIDRs so req.ip is the real client
# LOGIN_MAX_FAILURES=10       # failed logins per email and per IP ...
# LOGIN_WINDOW_MIN=15         # ... within this window before 429
# DEEP_AUDIT_WORKSPACE_ROOT=  # deep-audit workspaceDir/clonePath must be under this dir (unset = refused)
# DEEP_AUDIT_ALLOWED_HOSTS=   # comma-separated hostnames deep-audit may scan via targetUrl (unset = refused)
# PROD_REQUIRE_SECOND_APPROVER=false  # true: /prod/commands executor must differ from the approval's requester
# PROD_APPROVAL_TTL_MIN=10
# NODE_ENV=production         # also makes the API refuse to boot with the change-me placeholders above
# GLOBAL_RATE_MAX=3000        # requests/min per client address before 429 (raise for load tests: scripts/benchmark.mjs)
# JIT_REDEEM_MAX=20           # /jit/redeem attempts per minute per address
# ADMIN_REQUIRE_MFA=false     # true: /auth/step-up is refused until the user enrolls TOTP (POST /auth/mfa/enroll -> /confirm)
# MFA_ENCRYPTION_KEY=         # 64 hex chars sealing TOTP secrets; falls back to GIT_CREDENTIALS_KEY (required in production)
# JIT_ALLOW_LEGACY_TOKEN_HASH=false  # true: /jit/redeem also accepts a client-computed token_hash (old WP plugin); default refuses
# SCHED_CANCEL_POLL_MS=3000   # how often a running scan checks whether another replica cancelled its job
# TRIVY_CACHE_HOST_DIR=      # host dir reused by trivy scans; the API keeps its vuln DB fresh (resumable, checksum-verified) and scans run --skip-db-update. Must be writable by uid 10001
# TRIVY_DB_REFRESH_CRON=17 4 * * *

# ---- Sites, alerts and the task portal ----
# TELEGRAM_BOT_TOKEN=            # the alerts bot; each person must press Start in a chat with it before it can message them
# TELEGRAM_BOT_ID=platform       # label stored with queued alerts
# TELEGRAM_API_BASE_URL=         # only for a local stub / self-hosted Bot API server
# TASKPORTAL_BASE_URL=           # task portal API root; until set, scan-failure tasks queue up (Tasks page) and are sent when it is
# TASKPORTAL_API_TOKEN=
# TASKPORTAL_MAX_ATTEMPTS=8      # delivery attempts (exponential backoff) before a task is marked failed
