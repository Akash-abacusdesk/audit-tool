# Copy to /etc/platform/recovery-backup.env on the Security / Recovery Host.
# chmod 600 /etc/platform/recovery-backup.env
#
# Vaultwarden's own backup/recovery is owned by the external Vaultwarden
# microservice team; this host backs up PostgreSQL backup dumps + WAL only.

# Restic encrypts backups client-side. Use local disk, SFTP, S3, or another
# approved repository URL selected during provisioning.
RESTIC_REPOSITORY=/srv/backups/restic
RESTIC_PASSWORD_FILE=/etc/platform/restic-password

# Host paths on the Security / Recovery Host.
RECOVERY_ROOT=/opt/platform/tool/infrastructure/recovery-host
RECOVERY_BACKUP_DIR=/srv/platform-recovery/backups
RECOVERY_WAL_DIR=/srv/platform-recovery/wal

# Same replication credentials as recovery-host/.env (wal-receiver) — also
# used by bin/basebackup-recovery-host.sh to take periodic pg_basebackup
# snapshots into RECOVERY_BACKUP_DIR before this script restics it.
PRIMARY_PG_HOST=10.10.0.1
PRIMARY_PG_PORT=5432
PRIMARY_PG_REPLICATION_USER=replicator
PRIMARY_PG_REPLICATION_PASSWORD=replace-with-long-random-password

# Retention knobs. Tune after Section 18 capacity benchmarks.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
