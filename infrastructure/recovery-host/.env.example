# Copy to .env on the Security / Recovery Host. Never commit .env.
#
# Vaultwarden is NOT hosted here. It is an external microservice reached only
# through the control plane's private API client (packages/shared/src/
# vaultwarden-client.ts) via VAULTWARDEN_BASE_URL/VAULTWARDEN_API_TOKEN on the
# API host — not through this compose file.

# Replication connection to the primary PostgreSQL, used by wal-receiver
# (native pg_receivewal) to stream WAL continuously to ./wal.
PRIMARY_PG_HOST=10.10.0.1
PRIMARY_PG_PORT=5432
PRIMARY_PG_REPLICATION_USER=replicator
PRIMARY_PG_REPLICATION_PASSWORD=replace-with-long-random-password

# Backup/WAL reception paths on the recovery host. These are what
# bin/backup-recovery-host.sh ships to the Restic repository.
RECOVERY_BACKUP_DIR=./backups
RECOVERY_WAL_DIR=./wal
