# Copy to .env on the Security / Recovery Host. Never commit .env.

# Bind only to loopback or the WireGuard/private address for this host.
# Example WireGuard placeholder from docs/ops/networking-ssh.md: 10.10.0.2
VAULTWARDEN_BIND_IP=127.0.0.1
VAULTWARDEN_HOST_PORT=8080

# Public URL if exposed through a private/VPN-only reverse proxy.
# Do not expose this to the public internet unless the production access model is approved.
VAULTWARDEN_DOMAIN=https://vaultwarden.internal.example

# Prefer an Argon2 PHC string from Vaultwarden's admin-token generator.
# Minimal fallback for first boot: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=replace-with-long-random-admin-token

# Capacity knobs, selected after Section 18 benchmarks.
VAULTWARDEN_LOG_LEVEL=warn
VAULTWARDEN_WORKERS=10

# Backup/WAL reception paths on the recovery host. These are intentionally not
# mounted into Vaultwarden; recovery tooling consumes them separately.
RECOVERY_BACKUP_DIR=./backups
RECOVERY_WAL_DIR=./wal
