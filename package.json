{
  "name": "platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "validate:recovery-host": "node scripts/validate-recovery-host.mjs",
    "dev:api": "npm run dev -w @platform/api",
    "migrate": "npm run migrate -w @platform/api",
    "up": "docker compose -f infrastructure/docker-compose.dev.yml --env-file infrastructure/.env up -d",
    "down": "docker compose -f infrastructure/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}

